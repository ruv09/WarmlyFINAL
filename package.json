{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "typecheck": "pnpm run typecheck:warmly-v2",
    "typecheck:warmly-v2": "pnpm --dir artifacts/warmly-v2 exec tsc --noEmit",
    "start": "pnpm --dir artifacts/warmly-v2 start"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
