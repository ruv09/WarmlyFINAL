{
  "name": "@workspace/warmly-v2",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "dev": "expo start",
    "prebuild:android": "expo prebuild --platform android --clean",
    "setup:android": "bash scripts/setup-android.sh",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "expo prebuild --platform android && bash scripts/setup-android.sh && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.13",
    "typescript": "~6.0.3"
  }
