# Standalone Expo package. Local: pnpm install --ignore-workspace
# Must match artifacts/warmly-v2/pnpm-lock.yaml (autoInstallPeers: true).
# Root .npmrc uses auto-install-peers=false and must not apply on EAS.
auto-install-peers=true
strict-peer-dependencies=false
node-linker=hoisted
shamefully-hoist=true
