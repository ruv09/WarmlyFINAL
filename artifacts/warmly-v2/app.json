{
  "expo": {
    "name": "Warmly",
    "slug": "warmly",
    "scheme": "warmly",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.warmly.app"
    },
    "android": {
      "package": "com.warmly.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7FA06F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Warmly использует фото, чтобы сделать аватар профиля своим."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
