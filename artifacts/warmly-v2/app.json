{
  "expo": {
    "name": "Warmly",
    "slug": "warmly",
    "scheme": "warmly",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.warmly.app"
    },
    "android": {
      "package": "com.warmly.app",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7FA06F"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
